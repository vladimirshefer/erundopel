{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "erundopel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/lobbies", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY",
        "class_name": "LobbyDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LobbyDurableObject"]
    }
  ]
}
